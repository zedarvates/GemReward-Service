# GemReward-Service Configuration

# API Settings
API_PORT=8001
DEBUG=true

# Database
# For standalone, we recommend a dedicated PostgreSQL instance
DATABASE_URL=postgresql+asyncpg://gem_user:gem_pass@localhost/gem_reward_db

# Security
MASTER_API_KEY=your-super-admin-key-here
JWT_SECRET=change-this-for-standalone-service

# Multi-tenant defaults
MAX_APPS_PER_USER=10
DEFAULT_DAILY_GEM_LIMIT=1000

# Redis (Optional for caching leaderboards)
REDIS_URL=redis://localhost:6379/1
